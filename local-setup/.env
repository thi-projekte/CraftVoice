# Konfiguration für docker-compose.local.yml
# Nur für die LOKALE Entwicklung 

# Tag der Backend-Images aus ghcr
# Falls ein Image nicht gefunden wird, auf "sprint4" wechseln, aber muss noch ändern auf CraftVoice Projekt
BACKEND_TAG=main

# Lokale Dev-Zugangsdaten
POSTGRES_PASSWORD=postgres
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
